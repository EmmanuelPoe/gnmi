# systemd unit for running gnmic-rs on a host.
#   install -m 0755 target/release/gnmic-rs /usr/local/bin/
#   useradd --system --no-create-home --shell /usr/sbin/nologin gnmic
#   install -d /etc/gnmic-rs && cp examples/gnmic.yaml /etc/gnmic-rs/gnmic.yaml
#   cp deploy/gnmic-rs.service /etc/systemd/system/ && systemctl enable --now gnmic-rs
# Secrets referenced as ${VAR} in the config can go in /etc/gnmic-rs/env.
[Unit]
Description=gnmic-rs gNMI dial-out collector
Wants=network-online.target
After=network-online.target

[Service]
User=gnmic
Group=gnmic
EnvironmentFile=-/etc/gnmic-rs/env
ExecStart=/usr/local/bin/gnmic-rs --config /etc/gnmic-rs/gnmic.yaml
Restart=always
RestartSec=2
# Outputs drain and flush on SIGTERM.
TimeoutStopSec=30
LimitNOFILE=65536
# /var/lib/gnmic-rs for file outputs.
StateDirectory=gnmic-rs
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
